# Server-side settings. Never prefix secrets with NEXT_PUBLIC_.
SITE_URL=https://your-confirmed-domain.example
# One-time setup. Remove after creating the first admin.
ADMIN_SETUP_TOKEN=
# Supabase PostgreSQL: apply db/postgresql.sql before switching providers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for website images, created in Supabase Storage.
SUPABASE_STORAGE_BUCKET=beloftebos-images
# Branded transactional email (verify sender domain with Resend).
RESEND_API_KEY=
EMAIL_FROM=
# Calendar feeds. URLs often contain secrets; keep them server-side.
BOOKING_ICAL_URL=
LEKKESLAAP_ICAL_URL=
CALENDAR_ALLOWED_HOSTS=
ICAL_EXPORT_TOKEN=
# External scheduler calls POST /api/cron with Authorization: Bearer <value>.
CRON_SECRET=
# Analytics IDs are optional, can be set in admin after consent is configured.
GA4_ID=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
